# Database
DATABASE_URL=sqlite:///./data/mealmate.db

# Auth
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_DAYS=7

# Demo fallback
# Set true for offline demos. AI/image endpoints return deterministic demo data if providers are unavailable.
DEMO_MODE=false

# Recipe / workflow LLM provider
PRIMARY_PROVIDER=moonshot
MOONSHOT_API_KEY=your-moonshot-api-key
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# Kimi image recognition
MOONSHOT_VISION_MODEL=kimi-k2.6
