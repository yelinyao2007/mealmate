{
  "build": {
    "builder": "NIXPACKSBUILDER_BITNAMI_PYTHON",
    "buildpack": "python",
    "pythonVersion": "3.12"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "startCommand": "uvicorn app.main:app --host 0.0.0.0 --port $PORT"
  }
}